{
	"name": "second-brain",
	"version": "0.2.0",
	"description": "Second Brain — плагин Obsidian: самоопределяющаяся объектная метамодель личной базы знаний (MVP, этап A).",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"link:vault": "node scripts/link-vault.mjs",
		"check": "npm run typecheck && npm run test && npm run build"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"js-yaml": "^4.3.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	}
}
