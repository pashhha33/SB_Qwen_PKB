{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2018",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["DOM", "ES2018"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
